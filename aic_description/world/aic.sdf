<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="aic_world">

    <scene>
      <ambient>0 0 0</ambient>
      <grid>false</grid>
      <background>0.15 0.15 0.15 1</background>
    </scene>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <camera_clip>
          <near>0.01</near>
          <far>500</far>
        </camera_clip>
        <camera_pose>0.95 -0.1 1.3 0.0 0.0 3.14</camera_pose>
      </plugin>
      <plugin filename="GlobalIlluminationVct" name="GI">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
        <enabled>true</enabled>
        <highQuality>false</highQuality>
        <resolution>256 256 256</resolution>
        <octantCount>1 1 1</octantCount>
        <conserveMemory>true</conserveMemory>
        <thinWallCounter>1.0</thinWallCounter>
        <anisotropic>true</anisotropic>
        <bounceCount>3</bounceCount>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui>
      </plugin>
      <plugin filename="ViewAngle" name="View angle">
        <gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui>
      </plugin>
      <plugin filename="ApplyForceTorque">
        <gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui>
      </plugin>
      <plugin filename="VisualizeContacts" name="Visualize Contacts">
        <gz-gui><property key="state" type="string">docked</property></gz-gui>
      </plugin>
    </gui>

    <physics name="2ms" type="bullet-featherstone">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ScoringPlugin" name="aic_gazebo::ScoringPlugin"></plugin>
    <plugin filename="WorldSdfGeneratorPlugin" name="aic_gazebo::WorldSdfGeneratorPlugin">
        <save_world_delay_s>0.1</save_world_delay_s>
        <save_world_path>/tmp/aic.sdf</save_world_path>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <gravity>0 0 -9.8</gravity>

    <light type="spot" name="enclosure_light">
      <pose>0 0 2.5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <intensity>0.4</intensity>
      <attenuation>
        <range>2</range>
        <constant>1.0</constant>
      </attenuation>
      <spot>
        <inner_angle>0.1</inner_angle>
        <outer_angle>2</outer_angle>
      </spot>
    </light>

    <include>
      <uri>model://Enclosure</uri>
      <name>enclosure</name>
      <static>true</static>
    </include>
    <include>
      <uri>model://Enclosure Walls</uri>
      <name>enclosure walls</name>
      <static>true</static>
    </include>
    <include>
      <uri>model://Floor</uri>
      <name>floor</name>
      <static>true</static>
    </include>

    <model name="env_camera">
      <static>true</static>
      <pose>0.95 -0.1 1.3 0.0 0.0 3.14</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/env_camera/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
